# Upstream Project-CETI/wham clone. Kept here as a local dependency so the
# Python pipeline is on hand, but it is someone else's repository with its own
# .git and its own remote — not ours to redistribute. Clone it yourself with:
#   git clone https://github.com/Project-CETI/wham.git
wham/

# Audio and datasets are excluded by default and deliberately.
# Licensing differs per source: Common Voice is CC0, AudioSet is YouTube-derived
# with its own terms, Watkins and the UCLA Phonetics Lab Archive each have
# separate use conditions. Check before redistributing anything; use `git add -f`
# for individual files you are certain you may publish.
data/
datasets/
*.wav
*.mp3
*.flac
*.m4a
*.ogg
*.npy
*.pth
*.ckpt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Node — the explorer has no dependencies, but keep this safe
node_modules/

# macOS
.DS_Store

# Experiment artifacts — regenerable by re-running the check
experiments/**/artifacts/
